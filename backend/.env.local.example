# Copie este arquivo para .env.local (nunca vai pro git - está no .gitignore)
# e preencha com suas credenciais reais.

# Configurações do Banco na Nuvem (PostgreSQL + PostGIS):
DB_HOST=seu-banco-na-nuvem.com
DB_PORT=5432
DB_NAME=vaijunto_db
DB_USER=vaijunto_user
DB_PASS=sua_senha_do_banco_nuvem

# MAIL_USERNAME: sua conta Gmail completa (ex: seuemail@gmail.com)
# MAIL_PASSWORD: uma SENHA DE APP, não a senha normal da conta.
#   Gerar em: https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=
